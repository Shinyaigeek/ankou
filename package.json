{
  "name": "ankou-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ankou": "node packages/cli/dist/cli.js",
    "gallery": "node examples/gallery.mjs",
    "site": "node examples/gallery.mjs && node site/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "ankou-core": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
