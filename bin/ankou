#!/bin/sh
# Launcher for a from-source checkout, so `ankou` can live on PATH as a symlink
# into this repo: the symlink is followed back here to find the built CLI.
set -e

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname "$self")/.." && pwd)

if [ ! -f "$root/packages/cli/dist/cli.js" ]; then
  echo "ankou: nothing built yet in $root" >&2
  echo "      run: pnpm install && pnpm build" >&2
  exit 1
fi

exec node "$root/packages/cli/dist/cli.js" "$@"
