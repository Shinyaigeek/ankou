{
  "name": "ankou",
  "version": "0.1.0",
  "description": "Feed it markdown, text, HTML, PDFs or URLs, say what you want out of them, and read the result as a flipbook, deck, quiz, animation or summary.",
  "type": "module",
  "bin": {
    "ankou": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && node --test --experimental-strip-types test/*.test.ts"
  },
  "keywords": [
    "cli",
    "llm",
    "reading",
    "flipbook",
    "slides",
    "quiz",
    "pdf",
    "claude"
  ],
  "author": "Shinyaigeek",
  "license": "MIT",
  "homepage": "https://github.com/Shinyaigeek/ankou#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shinyaigeek/ankou.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Shinyaigeek/ankou/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ankou-core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0",
    "unpdf": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
